# SentinelGrid Environment Configuration Example
# Copy this file to .env and change values before production deployment.

# General
NODE_ENV=production
PORT=5000

# Security & Tokens
JWT_SECRET=replace-with-a-random-64-character-secret-key-2026
JWT_EXPIRES_IN=8h

# PostgreSQL Credentials
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-strong-database-password-2026
POSTGRES_DB=sentinelgrid

# Grafana Credentials
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password-2026

# External Integration Endpoints
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
UPTIME_KUMA_URL=http://uptime-kuma:3001
WAZUH_API_URL=https://wazuh-manager:55000
VMWARE_VCENTER_URL=https://vcenter.internal/sdk
